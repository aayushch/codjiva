# Editor settings that match the formatters: Prettier for JavaScript, TypeScript, Svelte and CSS,
# and rustfmt for Rust. Run `npm run format` at the top of the repository to format everything.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,ts,svelte,css,json,yml}]
indent_style = space
indent_size = 2
max_line_length = 80

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 80

[*.md]
trim_trailing_whitespace = false
