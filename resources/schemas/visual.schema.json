{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codjiva/visual.schema.json",
  "title": "Still visual definition (visual.json)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "camera": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number"
        },
        "dur": {
          "type": "number"
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "z": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 6
        }
      },
      "additionalProperties": false,
      "required": [
        "cx",
        "cy",
        "z"
      ]
    },
    "state": {
      "type": "object"
    },
    "legend": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "primary",
              "secondary",
              "transient",
              "batch",
              "tally"
            ]
          },
          "form": {
            "enum": [
              "crate",
              "record",
              "value",
              "key",
              "element",
              "chunk"
            ],
            "description": "the shape of the packet; a crate when omitted. Not allowed with the kinds batch and tally."
          },
          "html": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "html"
        ]
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "description": "where the part is in the code. The first entry is the code the app shows for the part: `line` is its first line and `end` its last.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "the last line of the part; the app shows at most 24 lines"
                }
              },
              "additionalProperties": false,
              "required": [
                "path",
                "line"
              ]
            }
          },
          "select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              "basis": {
                "enum": [
                  "stated",
                  "inferred"
                ]
              },
              "refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "line"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "text",
              "basis",
              "refs"
            ]
          },
          "inputs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": "what the part reads, each as a name from the code and what it is"
          },
          "outputs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": "what the part writes or returns, in the same form"
          },
          "transitions": {
            "type": "array",
            "maxItems": 12,
            "description": "where the work goes from this part",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "the condition, in a few words"
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "the id of another node, or a few words when the target is not drawn"
                }
              },
              "additionalProperties": false,
              "required": [
                "when",
                "to"
              ]
            }
          },
          "edgeCases": {
            "type": "array",
            "maxItems": 12,
            "description": "what the code does that a reader would not expect, each with the line that makes it so",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                },
                "example": {
                  "type": "string",
                  "maxLength": 120,
                  "description": "an input that shows the case"
                },
                "refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "line": {
                        "type": "integer"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "line"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "text",
                "refs"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "role",
          "select"
        ]
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "n": {
            "type": "integer"
          },
          "bubble": {
            "type": "object",
            "properties": {
              "kicker": {
                "type": "string"
              },
              "html": {
                "type": "string"
              },
              "tail": {
                "enum": [
                  "u",
                  "d",
                  "l",
                  "r"
                ]
              },
              "alarm": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "kicker",
              "html"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "n",
          "bubble"
        ]
      },
      "maxItems": 12
    },
    "stepper": {
      "type": "object",
      "description": "only in a step-through: what the viewer can run. The step function itself is in sim.js.",
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            },
            "hint": {
              "type": "string",
              "maxLength": 160
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "additionalProperties": false,
          "required": [
            "label"
          ]
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 28
              },
              "input": {
                "type": "string",
                "maxLength": 500
              },
              "expect": {
                "type": "object",
                "description": "the final value of some outputs, by output name"
              },
              "ref": {
                "type": "string",
                "pattern": "^[^:]+:\\d+(-\\d+)?$",
                "description": "path:line or path:start-end, relative to the workspace"
              }
            },
            "additionalProperties": false,
            "required": [
              "label",
              "input"
            ]
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "when": {
                "type": "string",
                "maxLength": 80
              },
              "select": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ref": {
                "type": "string",
                "pattern": "^[^:]+:\\d+(-\\d+)?$",
                "description": "path:line or path:start-end, relative to the workspace"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to",
              "when"
            ]
          }
        },
        "variables": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "meaning": {
                "type": "string",
                "maxLength": 160
              }
            },
            "additionalProperties": false,
            "required": [
              "name"
            ]
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "meaning": {
                "type": "string",
                "maxLength": 160
              }
            },
            "additionalProperties": false,
            "required": [
              "name"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "presets",
        "edges"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "camera",
    "nodes"
  ]
}
