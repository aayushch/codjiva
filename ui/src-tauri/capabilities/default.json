{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may ask the operating system for: native dialogs, and opening files and links in other apps.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-theme",
    "dialog:default",
    "opener:default"
  ]
}
