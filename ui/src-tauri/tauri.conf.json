{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codjiva",
  "version": "0.1.0",
  "identifier": "sh.aay.codjiva",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codjiva",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0c0e12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: codjiva: http://codjiva.localhost; font-src 'self' data:; frame-src codjiva: http://codjiva.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "See your code work",
    "longDescription": "Codjiva opens a codebase and shows a visual representation of each file instead of its text: an interactive blueprint, or a narrated film of the file and the code around it.",
    "copyright": "Copyright 2026 Aayush Chawla",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": { "installMode": "both" }
    },
    "linux": {
      "deb": { "section": "devel" }
    }
  }
}
